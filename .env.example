# ==============================================================================
# Environment Configuration Template for ML RAG Agent
# Rename or copy this file to `.env` and fill in the required values.
# ==============================================================================

# General Application Settings
PROJECT_NAME="ML RAG Agent"
ENVIRONMENT="development"  # development | staging | production
LOG_LEVEL="INFO"           # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Google Gemini API Settings
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL_NAME="gemini-1.5-flash"  # gemini-1.5-pro | gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048

# Embedding Model Settings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DEVICE="cpu"  # cpu | cuda

# Vector Database (ChromaDB) Settings
CHROMA_DB_DIR="data/vectordb"
CHROMA_COLLECTION_NAME="ml_documents"

# Document Processing & Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# RAG & Retrieval Pipeline Settings
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.65
ENABLE_RERANKER=false

# Automation & Email Integration Settings
AUTOMATION_WEBHOOK_SECRET="your-webhook-secret-here"
